# Copy this file to .env.local and fill it in.  NEVER commit .env.local.
#
# Get a free key at https://www.themoviedb.org/settings/api
# Recommended: paste the long "API Read Access Token" (starts with eyJ...).
TMDB_ACCESS_TOKEN=

# Alternative: if you only want to use the short 32-character "API Key",
# leave the line above empty and fill this one instead.
TMDB_API_KEY=

# Optional: your public site URL (used for social-share metadata).
# On Vercel this is detected automatically, so you can leave it empty.
NEXT_PUBLIC_SITE_URL=
